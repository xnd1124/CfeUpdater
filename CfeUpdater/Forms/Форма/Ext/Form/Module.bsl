#Область АвтоОбъединение
// Пытается автоматически объединить два варианта относительно общего предка.
//
// Параметры:
//   ОбщийПредок - Строка - базовая (исходная) версия многострочного текста
//   Вариант1    - Строка - первая изменённая версия
//   Вариант2    - Строка - вторая изменённая версия
//
// Возвращаемое значение:
//   Структура:
//     ВозможноАвтообъединение  - Булево - Истина если конфликтов нет
//     РезультатАвтообъединения - Строка - итоговый текст (заполнен только при Истина)
//
&НаКлиенте
Функция ВозможноАвтообъединение(Знач ОбщийПредок, Знач Вариант1, Знач Вариант2)

    Результат = Новый Структура("ВозможноАвтообъединение,РезультатАвтообъединения", Ложь, "");

    СтрокиПредок   = РазбитьНаСтроки(ОбщийПредок);
    СтрокиВариант1 = РазбитьНаСтроки(Вариант1);
    СтрокиВариант2 = РазбитьНаСтроки(Вариант2);

    Ханки1 = ПолучитьХанки(СтрокиПредок, СтрокиВариант1);
    Ханки2 = ПолучитьХанки(СтрокиПредок, СтрокиВариант2);

    Если ЕстьКонфликтХанков(Ханки1, Ханки2) Тогда
        Возврат Результат; 
    КонецЕсли;

    ОбъединенныеХанки          = ОбъединитьХанки(Ханки1, Ханки2);
    СтрокиИтога                = ПрименитьХанки(СтрокиПредок, ОбъединенныеХанки);

    Результат.ВозможноАвтообъединение  = Истина;
    Результат.РезультатАвтообъединения = СтрСоединить(СтрокиИтога, Символы.ПС);

    Возврат Результат;

КонецФункции   
// Объединяет два набора ханков в один упорядоченный список без дубликатов.
// Идентичные ханки (одинаковый диапазон предка и одинаковые новые строки)
// включаются один раз - это «одинаковое изменение», конфликтом не считается.
//
&НаКлиенте
Функция ОбъединитьХанки(Ханки1, Ханки2)

    Объединенные = Новый Массив;

    // Добавляем все ханки первого варианта
    Для Каждого Х Из Ханки1 Цикл
        Объединенные.Добавить(Х);
    КонецЦикла;

    // Добавляем ханки второго варианта, пропуская идентичные уже добавленным
    Для Каждого Х2 Из Ханки2 Цикл
        Дубликат = Ложь;
        Для Каждого Х1 Из Ханки1 Цикл
            Если Х1.НачалоА = Х2.НачалоА
                И Х1.КонецА  = Х2.КонецА
                И МассивыРавны(Х1.НовыеСтроки, Х2.НовыеСтроки) Тогда
                Дубликат = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если Не Дубликат Тогда
            Объединенные.Добавить(Х2);
        КонецЕсли;
    КонецЦикла;

    // Сортируем по НачалоА (пузырьковая; 1С не поддерживает Sort с компаратором)
    КолВо = Объединенные.Количество();
    Для Шаг1 = 0 По КолВо - 2 Цикл
        Для Шаг2 = 0 По КолВо - 2 - Шаг1 Цикл
            Если Объединенные[Шаг2].НачалоА > Объединенные[Шаг2 + 1].НачалоА Тогда
                Врем                    = Объединенные[Шаг2];
                Объединенные[Шаг2]      = Объединенные[Шаг2 + 1];
                Объединенные[Шаг2 + 1]  = Врем;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Возврат Объединенные;

КонецФункции

// Формирует итоговый массив строк, применяя ханки к строкам предка.
// Ханки должны быть отсортированы по НачалоА и не перекрываться.
//
&НаКлиенте
Функция ПрименитьХанки(СтрокиПредка, ОбъединенныеХанки)

    Итог = Новый Массив;
    ПозА = 0; // Текущая позиция в предке (первая ещё не скопированная строка)

    Для Каждого Ханк Из ОбъединенныеХанки Цикл

        // Копируем неизменённые строки предка до начала ханка
        Для Инд = ПозА По Ханк.НачалоА - 1 Цикл
            Итог.Добавить(СтрокиПредка[Инд]);
        КонецЦикла;

        // Вставляем новые строки ханка (при удалении - массив пуст ничего не добавляется)
        Для Каждого НовСтр Из Ханк.НовыеСтроки Цикл
            Итог.Добавить(НовСтр);
        КонецЦикла;

        ПозА = Ханк.КонецА; // Пропускаем удалённые / замененные строки предка

    КонецЦикла;

    // Копируем хвост предка после последнего ханка
    Для Инд = ПозА По СтрокиПредка.Количество() - 1 Цикл
        Итог.Добавить(СтрокиПредка[Инд]);
    КонецЦикла;

    Возврат Итог;

КонецФункции
// ============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ - РАБОТА СО СТРОКАМИ
// ============================================================================

// Разбивает многострочный текст на массив строк.
// Нормализует CRLF → LF. Пустые строки сохраняются.
&НаКлиенте
Функция РазбитьНаСтроки(Текст)
	НормТекст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Возврат СтрРазделить(НормТекст, Символы.ПС, Ложь);
КонецФункции

// Поэлементное сравнение двух массивов строк.
&НаКлиенте
Функция МассивыРавны(Масс1, Масс2)
	Если Масс1.Количество() <> Масс2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Инд = 0 По Масс1.Количество() - 1 Цикл
		Если Масс1[Инд] <> Масс2[Инд] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// ============================================================================
// DIFF: АЛГОРИТМ МАЙЕРСА
//
// Реализует алгоритм Eugene Myers «An O(ND) Difference Algorithm» (1986).
// Находит кратчайший редактирующий скрипт (SES) между двумя массивами строк.
//
// Основные понятия:
//   - Edit graph: вершина (x, y) - обработано x строк из А и y строк из Б
//   - Diagonal k = x - y
//   - Ход вправо (x++) = удалить А[x];  ход вниз (y++) = вставить Б[y]
//   - «Змейка» (snake) = диагональный ход (x++, y++) при А[x] == Б[y]
//
// Алгоритм ищет путь из (0,0) в (N,M) с минимальным числом
// недиагональных шагов D (=число правок).
//
// Память: каждый снимок массива В занимает O(N+M); всего D+1 снимков.
// При большом D (сильно различающиеся тексты) может потребоваться значительно
// памяти. Для текстов до ~1000 строк производительность приемлема.
// ============================================================================

// Возвращает упорядоченный массив операций редактирования:
//   Структура { Тип: "Равно"|"Удалить"|"Вставить", ИА: <инд. в А>, ИБ: <инд. в Б> }
//
//   "Равно"   - А[ИА] == Б[ИБ] (строки совпадают)
//   "Удалить" - удалить А[ИА] (ИБ = позиция в Б в этот момент, вспомогательное)
//   "Вставить" - вставить Б[ИБ]; ИА = позиция в А, перед которой вставка
//
&НаКлиенте
Функция МайерсДифф(СтрокиА, СтрокиБ)

	СтрокВА = СтрокиА.Количество();
	СтрокВБ = СтрокиБ.Количество();

	МаксД    = СтрокВА + СтрокВБ;          // Максимально возможное число правок
	Смещение = МаксД;          // Смещение для обращения к диагонали k: В[k + Смещение]
	Размер   = 2 * МаксД + 2; // Размер массива диагоналей

	// МаксКоординатаX[k + Смещение] = максимальная достигнутая координата x на диагонали k
	МаксКоординатаX = Новый Массив(Размер);
	Для Инд = 0 По Размер - 1 Цикл
		МаксКоординатаX[Инд] = 0;
	КонецЦикла;
	// Инициализация: перед первым шагом d=0 «приходим» на диагональ k=0
	// с k=1 (фиктивное начальное состояние, стандартный приём)
	МаксКоординатаX[1 + Смещение] = 0;

	// Трасса[d] = снимок массива МаксКоординатаX в начале итерации d (до обновления под d)
	// Используется при обратном проходе для восстановления пути
	Трасса = Новый Массив;

	Для д = 0 По МаксД Цикл

		// --- Сохраняем снимок массива МаксКоординатаX ---
		ВСнапшот = Новый Массив(Размер);
		Для Инд = 0 По Размер - 1 Цикл
			ВСнапшот[Инд] = МаксКоординатаX[Инд];
		КонецЦикла;
		Трасса.Добавить(ВСнапшот);

		// --- Обрабатываем все диагонали для d правок ---
		// При d правках возможны диагонали k = -d, -d+2, ..., d-2, d
		// (1С не поддерживает Шаг в Для, используем Пока)
		к = -д;
		Пока к <= д Цикл
			кИндекс = к + Смещение;

			// Определяем точку входа на диагональ k:
			//   - если k == -d: обязаны прийти сверху (ход вниз = вставка)
			//   - если k ==  d: обязаны прийти слева (ход вправо = удаление)
			//   - иначе: выбираем лучший из двух соседей
			Если к = -д Тогда
				х = МаксКоординатаX[кИндекс + 1];         // Пришли с диагонали k+1 (вниз)
			ИначеЕсли к = д Тогда
				х = МаксКоординатаX[кИндекс - 1] + 1;     // Пришли с диагонали k-1 (вправо), x++
			ИначеЕсли МаксКоординатаX[кИндекс - 1] < МаксКоординатаX[кИндекс + 1] Тогда
				х = МаксКоординатаX[кИндекс + 1];         // Сосед сверху даёт дальше
			Иначе
				х = МаксКоординатаX[кИндекс - 1] + 1;     // Сосед слева даёт дальше
			КонецЕсли;

			у = х - к;

			// Расширяем «змейку»: скользим по диагонали пока строки равны
			Пока х < СтрокВА И у < СтрокВБ И СтрокиА[х] = СтрокиБ[у] Цикл
				х = х + 1;
				у = у + 1;
			КонецЦикла;

			МаксКоординатаX[кИндекс] = х;

			// Достигли конца обоих текстов - нашли SES за d правок
			Если х >= СтрокВА И у >= СтрокВБ Тогда
				Возврат ОбратныйПроход(СтрокиА, СтрокиБ, Трасса, д, Смещение);
			КонецЕсли;

			к = к + 2; // Шаг 2: следующая допустимая диагональ
		КонецЦикла;

	КонецЦикла;

	// Сюда не попадаем при корректных входных данных
	Возврат Новый Массив;

КонецФункции

// Восстанавливает редактирующий скрипт из трассы (обратный проход Myers-а).
// Идём от (N, M) назад к (0, 0), на каждом шаге определяя нередиагональный ход.
//
// Параметры:
//   СтрокиА - Массив из Строка - исходный массив строк
//   СтрокиБ - Массив из Строка - целевой массив строк
//   ТрассаСостояний  - Массив из число -  Число снимков В[d] для d = 0..Расстояние
//   Расстояние    - Число  - число правок в найденном SES
//   Смещение - Число - смещение индексов диагоналей
//
&НаКлиенте
Функция ОбратныйПроход(СтрокиА, СтрокиБ, ТрассаСостояний, Расстояние, Смещение)

	РазмерА = СтрокиА.Количество();
	РазмерБ = СтрокиБ.Количество();
	КоординатаX = РазмерА;
	КоординатаY = РазмерБ;

	ОперацииОбратно = Новый Массив; // Операции собираются в обратном порядке

	// (1С не поддерживает Шаг в Для, используем Пока)
	ТекущееРасстояние = Расстояние;
	Пока ТекущееРасстояние >= 1 Цикл

		// Снимок МаксКоординатаX, сохранённый в начале итерации ТекущееРасстояние 
		// (= состояние после итерации ТекущееРасстояние-1)
		МаксКоординатаX       = ТрассаСостояний[ТекущееРасстояние];
		Диагональ       = КоординатаX - КоординатаY;
		ИндексДиагонали = Диагональ + Смещение;

		// Повторяем то же условие, что и при прямом проходе,
		// чтобы определить, с какой диагонали пришли
		Если Диагональ = -ТекущееРасстояние Тогда
			ПредыдущаяДиагональ = Диагональ + 1; // Пришли сверху (вставка)
		ИначеЕсли Диагональ = ТекущееРасстояние Тогда
			ПредыдущаяДиагональ = Диагональ - 1; // Пришли слева (удаление)
		ИначеЕсли МаксКоординатаX[ИндексДиагонали - 1] < МаксКоординатаX[ИндексДиагонали + 1] Тогда
			ПредыдущаяДиагональ = Диагональ + 1; // Сосед сверху был лучше
		Иначе
			ПредыдущаяДиагональ = Диагональ - 1; // Сосед слева был лучше
		КонецЕсли;

		// Координаты начала текущего диагонального пробега (до змейки)
		ПредыдущаяКоординатаX = МаксКоординатаX[ПредыдущаяДиагональ + Смещение];
		ПредыдущаяКоординатаY = ПредыдущаяКоординатаX - ПредыдущаяДиагональ;

		// Первая точка на диагонали Диагональ (после нередиагонального шага)
		Если ПредыдущаяДиагональ = Диагональ + 1 Тогда
			// Пришли сверху: y увеличился на 1 (вставка)
			НачалоПробегаX = ПредыдущаяКоординатаX;
			НачалоПробегаY = ПредыдущаяКоординатаY + 1;
		Иначе
			// Пришли слева: x увеличился на 1 (удаление)
			НачалоПробегаX = ПредыдущаяКоординатаX + 1;
			НачалоПробегаY = ПредыдущаяКоординатаY;
		КонецЕсли;

		// Добавляем операции «Равно» вдоль змейки (в обратном направлении)
		ТекЗмейкаX = КоординатаX;
		ТекЗмейкаY = КоординатаY;
		Пока ТекЗмейкаX > НачалоПробегаX И ТекЗмейкаY > НачалоПробегаY Цикл
			ТекЗмейкаX = ТекЗмейкаX - 1;
			ТекЗмейкаY = ТекЗмейкаY - 1;
			Операция = Новый Структура("Тип,ИА,ИБ", "Равно", ТекЗмейкаX, ТекЗмейкаY);
			ОперацииОбратно.Добавить(Операция);
		КонецЦикла;

		// Добавляем нередиагональный шаг
		Если ПредыдущаяДиагональ = Диагональ + 1 Тогда
			// Ход вниз = вставка СтрокиБ[ПредыдущаяКоординатаY]
			Операция = Новый Структура("Тип,ИА,ИБ", "Вставить", ПредыдущаяКоординатаX, ПредыдущаяКоординатаY);
		Иначе
			// Ход вправо = удаление СтрокиА[ПредыдущаяКоординатаX]
			Операция = Новый Структура("Тип,ИА,ИБ", "Удалить", ПредыдущаяКоординатаX, ПредыдущаяКоординатаY);
		КонецЕсли;
		ОперацииОбратно.Добавить(Операция);

		КоординатаX = ПредыдущаяКоординатаX;
		КоординатаY = ПредыдущаяКоординатаY;

		ТекущееРасстояние = ТекущееРасстояние - 1; // Шаг -1
	КонецЦикла;

	// Начальная змейка при d=0 (совпадающий префикс)
	Пока КоординатаX > 0 И КоординатаY > 0 Цикл
		КоординатаX = КоординатаX - 1;
		КоординатаY = КоординатаY - 1;
		Операция = Новый Структура("Тип,ИА,ИБ", "Равно", КоординатаX, КоординатаY);
		ОперацииОбратно.Добавить(Операция);
	КонецЦикла;

	// Разворачиваем массив (операции были добавлены в обратном порядке)
	Количество = ОперацииОбратно.Количество();
	Результат = Новый Массив(Количество);
	Для Инд = 0 По Количество - 1 Цикл
		Результат[Инд] = ОперацииОбратно[Количество - 1 - Инд];
	КонецЦикла;

	Возврат Результат;

КонецФункции

// ============================================================================
// ХАНКИ (HUNKS) - БЛОКИ ИЗМЕНЕНИЙ
//
// Ханк описывает атомарное изменение: непрерывный диапазон строк предка
// A[НачалоА .. КонецА) заменяется на НовыеСтроки.
//
//   Замена:         НачалоА < КонецА, НовыеСтроки непусты
//   Удаление:       НачалоА < КонецА, НовыеСтроки пусты
//   Чистая вставка: НачалоА = КонецА, НовыеСтроки непусты
// ============================================================================

// Преобразует редактирующий скрипт Myers-а в массив ханков.
// Последовательные нередиагональные операции объединяются в один ханк.
//
// Структура ханка:
//   НачалоА     - Число - начальный индекс в предке (0-based, включительно)
//   КонецА      - Число - конечный индекс в предке (0-based, исключительно)
//   НовыеСтроки - Массив - строки, заменяющие A[НачалоА..КонецА)
//
&НаКлиенте
Функция ПолучитьХанки(СтрокиПредок, СтрокиВарианта)

	Операции = МайерсДифф(СтрокиПредок, СтрокиВарианта);

	Ханки    = Новый Массив;
	ТекХанк  = Неопределено;
	ПозА     = 0; // Текущая позиция в А (сдвигается операциями "Равно" и "Удалить")

	Для Каждого Оп Из Операции Цикл

		Если Оп.Тип = "Равно" Тогда
			// Совпадающая строка - закрываем текущий ханк
			Если ТекХанк <> Неопределено Тогда
				Ханки.Добавить(ТекХанк);
				ТекХанк = Неопределено;
			КонецЕсли;
			ПозА = Оп.ИА + 1;

		ИначеЕсли Оп.Тип = "Удалить" Тогда
			// Удалённая строка А[ИА]
			Если ТекХанк = Неопределено Тогда
				ТекХанк = Новый Структура("НачалоА,КонецА,НовыеСтроки",
				                          Оп.ИА, Оп.ИА + 1, Новый Массив);
			Иначе
				// Расширяем правую границу существующего ханка
				ТекХанк.КонецА = Оп.ИА + 1;
			КонецЕсли;
			ПозА = Оп.ИА + 1;

		Иначе // "Вставить"
			// Вставка Б[ИБ] перед позицией ПозА в А
			Если ТекХанк = Неопределено Тогда
				// Чистая вставка: НачалоА = КонецА = текущая позиция в А
				ТекХанк = Новый Структура("НачалоА,КонецА,НовыеСтроки",
				                          ПозА, ПозА, Новый Массив);
			КонецЕсли;
			ТекХанк.НовыеСтроки.Добавить(СтрокиВарианта[Оп.ИБ]);
			// ПозА не меняется при вставке

		КонецЕсли;

	КонецЦикла;

	// Закрываем последний ханк, если остался незакрытым
	Если ТекХанк <> Неопределено Тогда
		Ханки.Добавить(ТекХанк);
	КонецЕсли;

	Возврат Ханки;

КонецФункции

// ============================================================================
// ОБНАРУЖЕНИЕ КОНФЛИКТОВ
// ============================================================================

// Проверяет, есть ли конфликтующие пары ханков между двумя наборами изменений.
&НаКлиенте
Функция ЕстьКонфликтХанков(Ханки1, Ханки2)
	Для Каждого Ханк1 Из Ханки1 Цикл
		Для Каждого Ханк2 Из Ханки2 Цикл
			Если ХанкиКонфликтуют(Ханк1, Ханк2) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Определяет, конфликтуют ли два ханка.
//
// Правила:
//   1. Одинаковые изменения (тот же диапазон А и те же новые строки) - НЕ конфликт.
//   2. Обе чистые вставки в одну позицию с разным содержимым - КОНФЛИКТ.
//   3. Перекрывающиеся (строгое пересечение) интервалы с разными изменениями - КОНФЛИКТ.
//
// Примечание: вставка в позицию e и изменение диапазона [s, e) не считаются
// конфликтом (классическая семантика 3-way merge: изменения независимы).
//
&НаКлиенте
Функция ХанкиКонфликтуют(Ханк1, Ханк2)

	Начало1 = Ханк1.НачалоА;
	Конец1 = Ханк1.КонецА;
	Начало2 = Ханк2.НачалоА;
	Конец2 = Ханк2.КонецА;

	// Правило 1: идентичные изменения - конфликта нет
	Если Начало1 = Начало2 И Конец1 = Конец2 И МассивыРавны(Ханк1.НовыеСтроки, Ханк2.НовыеСтроки) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Правило 2: обе - чистые вставки в одну и ту же позицию
	Если Начало1 = Конец1 И Начало2 = Конец2 И Начало1 = Начало2 Тогда
		// Разное содержимое при вставке в одно место - конфликт
		Возврат Истина;
	КонецЕсли;

	// Правило 3: строгое пересечение интервалов [c1, e1) и [c2, e2)
	// Интервалы пересекаются, если c1 < e2 И c2 < e1
	// (чистые вставки e==c не пересекаются с диапазонами по этой формуле,
	//  что соответствует стандартной семантике 3-way merge)
	Если Начало1 < Конец2 И Начало2 < Конец1 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
#КонецОбласти